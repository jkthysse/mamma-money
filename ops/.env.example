ENVIRONMENT=development

# Target platform for the Docker build.
# Mac (Apple Silicon): linux/arm64
# Windows / Linux / CI: linux/amd64
TARGET_PLATFORM=linux/amd64
HOST_PROTOCOL=http
HOST_SERVER_NAME=localhost
HOST_PORT=8080

# mamma-money-api:local   ← your local build (default)
# mamma-money-api:a3f9c2d ← CI build tagged with git short SHA
# mamma-money-api:v1.0.0  ← a release
DOCKER_IMAGE=mamma-money-api
DOCKER_IMAGE_TAG=local
DOCKER_CONTAINER_NAME=mamma-money-api
DOCKER_BUILD_CONTEXT=src

# --- k3d cluster configuration ---
# Name of the local k3d cluster.
CLUSTER_NAME=mamma-money

# Number of server and agent nodes.
# Skinny single-node setup: CLUSTER_SERVERS=1, CLUSTER_AGENTS=0
# With a dedicated agent node: CLUSTER_SERVERS=1, CLUSTER_AGENTS=1
CLUSTER_SERVERS=1
CLUSTER_AGENTS=0

# Host port mapped into the cluster for direct NodePort access.
# Must match service.nodePort in values.local.yaml.
# Set to empty string to disable port mapping (use kubectl port-forward instead).
NODE_PORT=30080